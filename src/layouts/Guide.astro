---
// Guide (content page) shell — static HTML only, no islands, so every word is
// in the raw response for crawlers. Review state comes from src/lib/guides.mjs:
// an unreviewed guide renders noindex plus a visible "not yet reviewed" notice.
import Layout from "./Layout.astro";
import { guides, hubPath } from "../lib/guides.mjs";

const site = "https://bppvcoach.com";

interface Faq {
  q: string;
  /** Plain text — reused verbatim in FAQPage JSON-LD, so no markup. */
  a: string;
}

interface Source {
  label: string;
  href: string;
}

interface Props {
  /** <title> — query first, brand last. Must differ from the H1. */
  title: string;
  description: string;
  /** Must match an entry in src/lib/guides.mjs. */
  path: string;
  faq: Faq[];
  sources: Source[];
}

const { title, description, path, faq, sources } = Astro.props;

const entry = guides.find((g) => g.path === path);
if (!entry) throw new Error(`Guide ${path} is missing from src/lib/guides.mjs`);
const h1 = entry.title;
const reviewed = entry.reviewed;
const related = guides.filter((g) => g.path !== path);
const url = `${site}${path}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${url}#article`,
      headline: h1,
      description,
      url,
      mainEntityOfPage: url,
      publisher: { "@id": `${site}/#organization` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Guides", item: `${site}${hubPath}` },
        { "@type": "ListItem", position: 3, name: h1, item: url },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<Layout title={title} description={description} path={path} noindex={!reviewed}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="min-h-screen bg-background text-foreground">
    <header class="sticky top-0 z-10 border-b bg-background/85 backdrop-blur">
      <div class="mx-auto flex max-w-2xl items-center justify-between px-4 py-3">
        <a href="/" class="flex items-center gap-2">
          <span class="grid h-8 w-8 place-items-center rounded-full bg-primary text-primary-foreground font-bold">B</span>
          <span class="text-lg font-semibold tracking-tight">BPPVCoach</span>
        </a>
        <a href={hubPath} class="text-sm text-muted-foreground hover:text-foreground">Guides</a>
      </div>
    </header>

    <main class="mx-auto max-w-2xl px-4 py-6 pb-24">
      <nav aria-label="Breadcrumb" class="text-sm text-muted-foreground">
        <a href="/" class="hover:text-foreground">Home</a>
        <span aria-hidden="true"> / </span>
        <a href={hubPath} class="hover:text-foreground">Guides</a>
      </nav>

      <h1 class="mt-3 text-balance text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">{h1}</h1>

      {!reviewed && (
        <p class="mt-4 rounded-2xl border border-warning/40 bg-warning/10 p-4 text-sm">
          <strong>Draft — not yet clinician-reviewed.</strong> Reviewer: ‹FILL: name, credential (e.g. PT, vestibular certification)›.
          Statements marked <mark>[VERIFY]</mark> are awaiting a source check.
        </p>
      )}

      <article class="guide mt-6">
        <slot />
      </article>

      <section class="guide mt-10" aria-labelledby="faq">
        <h2 id="faq">Questions people ask</h2>
        {faq.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </section>

      <aside class="mt-10 rounded-2xl border border-destructive/40 bg-destructive/5 p-5 text-sm leading-relaxed">
        <strong>Seek urgent care instead</strong> if dizziness comes with new weakness, numbness,
        facial drooping, trouble speaking, fainting, a severe headache, chest pain, or you can't walk.
        Those are not BPPV patterns. BPPVCoach does not diagnose vertigo or tell you which ear or canal is involved.
      </aside>

      <section class="guide mt-10" aria-labelledby="sources">
        <h2 id="sources">Sources</h2>
        <ol class="sources">
          {sources.map((s, i) => (
            <li id={`src-${i + 1}`}><a href={s.href} rel="nofollow noopener" target="_blank">{s.label}</a></li>
          ))}
        </ol>
      </section>

      <nav class="mt-10" aria-labelledby="related">
        <h2 id="related" class="text-lg font-semibold">Related guides</h2>
        <ul class="mt-3 space-y-3">
          {related.map((g) => (
            <li class="rounded-2xl border bg-card p-4">
              <a href={g.path} class="font-medium hover:underline">{g.title}</a>
              <p class="mt-1 text-sm text-muted-foreground">{g.blurb}</p>
            </li>
          ))}
          <li class="text-sm"><a href={hubPath} class="text-muted-foreground hover:text-foreground">All BPPV guides →</a></li>
        </ul>
      </nav>
    </main>
  </div>
</Layout>

<style is:global>
  .guide h2 { margin-top: 2.25rem; font-size: 1.35rem; font-weight: 600; letter-spacing: -0.01em; }
  .guide h3 { margin-top: 1.5rem; font-size: 1.05rem; font-weight: 600; }
  .guide p, .guide ul, .guide ol, .guide table { margin-top: 0.85rem; line-height: 1.7; }
  .guide ul { list-style: disc; padding-left: 1.25rem; }
  .guide ol { list-style: decimal; padding-left: 1.25rem; }
  .guide li + li { margin-top: 0.35rem; }
  .guide a { text-decoration: underline; text-underline-offset: 2px; }
  .guide .answer { font-size: 1.1rem; line-height: 1.7; }
  .guide table { width: 100%; border-collapse: collapse; font-size: 0.925rem; display: block; overflow-x: auto; }
  .guide th, .guide td { border-bottom: 1px solid var(--color-border); padding: 0.5rem 0.6rem 0.5rem 0; text-align: left; vertical-align: top; }
  .guide .callout { margin-top: 1.25rem; border: 1px solid var(--color-border); background: var(--color-card); border-radius: 1rem; padding: 1rem 1.25rem; }
  .guide .faq-item h3 { margin-top: 1.25rem; }
  .guide .sources { font-size: 0.875rem; }
  .guide cite { font-style: normal; font-size: 0.8em; vertical-align: super; }
  mark { background: color-mix(in oklab, var(--color-warning) 35%, transparent); color: inherit; padding: 0 0.2em; border-radius: 0.2em; }
</style>
